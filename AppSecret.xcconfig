// Woosmap private API key. Reaches the app as the `WMKey` Info.plist entry,
// read back by `AppConfig.privateKey`.
DEFAULT_PRIVATE_KEY = <<YOUR PRIVATE KEY>>


// Optional local override, generated from the environment by scripts/make-app-secret.sh.
// Absent by default; when present its assignment wins because it is included last.
#include? "AppSecret.local.xcconfig"
